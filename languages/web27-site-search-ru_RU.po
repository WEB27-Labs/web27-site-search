msgstr "Помощник"

#: StudioAdmin.php:225
msgid "Assistant name"
msgstr "Имя помощника"

#: Console.php:44
msgid "Authentication failed (401). Verify the selected provider key."
msgstr "Ошибка авторизации (401). Проверьте ключ выбранного провайдера."

#: StudioAdmin.php:221
msgid "Automatic — site or page language"
msgstr "Автоматически — язык сайта или страницы"

msgid "Available"
msgstr "Доступен"

#: AdminGuide.php:355
msgid ""
"Avoid continuous retries; check provider and model limits. Public HTTP 429 can also be the local "
"IP rate limit."
msgstr ""
"Избегайте постоянных повторных запросов; проверьте ограничения провайдера и модели. HTTP 429 в "
"публичном интерфейсе также может означать локальное ограничение по IP."

#: AdminGuide.php:48 AdminGuide.php:81 AdminGuide.php:172 AdminGuide.php:222 AdminGuide.php:233
#: AdminGuide.php:245 AdminGuide.php:260 AdminGuide.php:274 AdminGuide.php:325 AdminGuide.php:387
